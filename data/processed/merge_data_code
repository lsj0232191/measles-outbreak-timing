# printing function
def log(msg):
    print(f"[INFO] {msg}")
    
# standardizing function
def normalize(s):
    """Lowercase, remove punctuation, collapse spaces."""
    if pd.isna(s):
        return ""
    s = str(s).lower()
    for ch in [":", "_", "-", "/", ","]:
        s = s.replace(ch, " ")
    # keep only letters / digits / spaces
    s = "".join(ch for ch in s if ch.isalnum() or ch.isspace())
    # collapse multiple spaces
    return " ".join(s.split())

