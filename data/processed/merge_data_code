# fips inspector
def inspect_fips(path):
    try:
        df = pd.read_csv(path, nrows=5)
    except Exception as e:
        log(f"Could not read {path}: {e}")
        return

    cols = [c.lower() for c in df.columns]
    fips_like = [c for c in df.columns if "fips" in c.lower()]
    log(f"Inspecting {path.name}")
    log(f"  Columns: {df.columns.tolist()}")
    if fips_like:
        log(f"  FIPS-like columns: {fips_like}")
    elif any("geo_id" in c for c in cols):
        log("  ℹ️ Has GEO_ID; we can derive FIPS from last 5 characters.")
    elif any("location_id" in c for c in cols):
        log("  ℹ️ Has location_id; we can zero-pad to get FIPS.")
    else:
        log("  ⚠️ No obvious FIPS column. May need mapping or filename-based inference.")

# inspect key files
inspect_fips(ACS_FILE)
inspect_fips(OUTBREAK_FILE)
for vf in VACC_FILES:
    if vf.exists():
        inspect_fips(vf)
if GOOGLE_TRENDS_FILE.exists():
    inspect_fips(GOOGLE_TRENDS_FILE)

#acs, fips, state name
log("Loading ACS...")
acs = pd.read_csv(ACS_FILE, dtype={"GEO_ID": str})

if "FIPS" not in acs.columns:
    if "GEO_ID" in acs.columns:
        acs["FIPS"] = acs["GEO_ID"].str[-5:]
        log("  Derived FIPS from GEO_ID.")
    else:
        raise ValueError("ACS file must have GEO_ID or FIPS to create county codes.")

acs["FIPS"] = acs["FIPS"].astype(str).str.zfill(5)
acs = acs.drop_duplicates(subset="FIPS")

# derive state name from NAME like "Albany County, New York"
if "NAME" in acs.columns:
    acs["state_name"] = acs["NAME"].apply(lambda x: x.split(",")[-1].strip().title())

    # also derive county name + normalized county for matching
    acs["county_name_raw"] = acs["NAME"].apply(lambda x: x.split(",")[0])
    # strip suffixes like "County", "Parish", "Borough", etc., then normalize
    def clean_county_name(s):
        s = str(s)
        for suf in [" County", " Parish", " Borough", " Census Area", " Municipality"]:
            s = s.replace(suf, "")
        return normalize(s)
    acs["county_norm"] = acs["county_name_raw"].apply(clean_county_name)
else:
    acs["state_name"] = np.nan
    acs["county_norm"] = np.nan
    log("⚠️ ACS has no NAME column; state_name and county_norm left as NaN.")

# outbreak data
log("Loading outbreak data...")
outbreak = pd.read_csv(OUTBREAK_FILE, dtype={"location_id": str})

# keep lab-confirmed cases only (adjust if needed)
if "outcome_type" in outbreak.columns:
    outbreak = outbreak[outbreak["outcome_type"] == "case_lab-confirmed"]

# date & FIPS
outbreak["date"] = pd.to_datetime(outbreak["date"], errors="coerce")
if "FIPS" not in outbreak.columns:
    if "location_id" in outbreak.columns:
        outbreak["FIPS"] = outbreak["location_id"].str.zfill(5)
        log("  Derived FIPS from location_id.")
    else:
        raise ValueError("Outbreak file must have either FIPS or location_id.")

outbreak["FIPS"] = outbreak["FIPS"].astype(str).str.zfill(5)
outbreak["cases"] = pd.to_numeric(outbreak["value"], errors="coerce").fillna(0)

outbreak["month_period"] = outbreak["date"].dt.to_period("M")
outbreak["year"] = outbreak["date"].dt.year
outbreak["month"] = outbreak["date"].dt.month

# aggregate to county×month
panel = (
    outbreak.groupby(["FIPS", "month_period", "year", "month"], as_index=False)["cases"]
    .sum()
)
log(f"  Outbreak panel has {len(panel)} county-month rows with at least 1 case row.")

# create full grid of counties × months (to include zeros / non-outbreak months)
all_months = pd.period_range(panel["month_period"].min(),
                             panel["month_period"].max(),
                             freq="M")
all_counties = acs["FIPS"].unique()

panel_full = (
    pd.MultiIndex.from_product([all_counties, all_months],
                               names=["FIPS", "month_period"])
    .to_frame(index=False)
)

panel = panel_full.merge(
    panel[["FIPS", "month_period", "year", "month", "cases"]],
    on=["FIPS", "month_period"],
    how="left",
)

panel["cases"] = panel["cases"].fillna(0)
panel["year"] = panel["year"].fillna(panel["month_period"].dt.year).astype(int)
panel["month"] = panel["month"].fillna(panel["month_period"].dt.month).astype(int)

# binary event indicator
panel["event"] = (panel["cases"] > 0).astype(int)

# time index starting at 1
panel = panel.sort_values(["month_period"])
panel["month_index"] = panel["month_period"].rank(method="dense").astype(int)

# ACS demographics
log("Merging ACS demographics...")
demo_cols = [c for c in acs.columns if c.startswith(("DP02_", "DP03_", "DP04_", "DP05_"))]
acs_demo = acs[["FIPS", "state_name"] + demo_cols]

panel = panel.merge(acs_demo, on="FIPS", how="left")

# vaccination data
# vaccination data (ONLY kindergarten MMR, state-specific)
log("Processing kindergarten vaccination data...")

vf = VACC_FILES[0]
if not vf.exists():
    log(f"  ⚠️ Vaccination file not found; vacc_coverage set to NaN.")
    panel["vacc_coverage"] = np.nan
else:
    df = pd.read_csv(vf)

    # keep MMR rows, state-level only
    df = df[
        df["Vaccine/Exemption"].astype(str).str.contains("mmr", case=False, na=False)
        & df["Geography Type"].astype(str).str.contains("state", case=False, na=False)
    ]

    # keep only needed columns
    df = df[["Geography", "School Year", "Estimate (%)"]].copy()
    df.columns = ["state_name", "school_year", "vacc_coverage"]

    # clean coverage
    df["vacc_coverage"] = (
        df["vacc_coverage"].astype(str)
        .str.replace("%", "", regex=False)
        .str.replace("<1", "0.5", regex=False)
    )
    df["vacc_coverage"] = pd.to_numeric(df["vacc_coverage"], errors="coerce")

    # clean state names
    df["state_name"] = df["state_name"].astype(str).str.strip().str.title()

    # extract year from school year (take first 4-digit year, e.g. "2021-22" -> 2021)
    df["year"] = df["school_year"].astype(str).str.extract(r"(\d{4})")
    df["year"] = pd.to_numeric(df["year"], errors="coerce")
    df = df[df["year"].notna()]
    df["year"] = df["year"].astype(int)

    # state-year averages
    vacc = (
        df.groupby(["state_name", "year"], as_index=False)["vacc_coverage"]
        .mean()
    )

    log(f"  Kindergarten vaccination table has {len(vacc)} state-year rows.")

    panel["year"] = pd.to_numeric(panel["year"], errors="coerce").astype(int)
    vacc["year"] = pd.to_numeric(vacc["year"], errors="coerce").astype(int)

    # merge state-year vaccination to all counties in that state
    panel = panel.merge(vacc, on=["state_name", "year"], how="left")

# --- STATE-SPECIFIC SYNTHETIC 2025 BLOCK ---

if "vacc" in locals() and len(vacc) > 0:
    # last observed year per state
    last_year = (
        vacc.groupby("state_name", as_index=False)["year"]
        .max()
        .rename(columns={"year": "last_year"})
    )

    vacc_last = last_year.merge(
        vacc,
        left_on=["state_name", "last_year"],
        right_on=["state_name", "year"],
        how="left",
    )

    months = np.arange(1, 13)
    season_peak_month = 9
    season_amplitude = 0.30

    rows = []
    for m in months:
        offset = season_amplitude * np.sin(2 * np.pi * (m - season_peak_month) / 12)
        tmp = vacc_last.copy()
        tmp["year"] = 2025
        tmp["month"] = m
        tmp["vacc_coverage_2025"] = tmp["vacc_coverage"] + offset
        rows.append(tmp[["state_name", "year", "month", "vacc_coverage_2025"]])

    monthly_2025 = pd.concat(rows, ignore_index=True)

    # merge state-specific 2025 monthly coverage
    panel = panel.merge(
        monthly_2025,
        on=["state_name", "year", "month"],
        how="left"
    )

    # overwrite vacc_coverage ONLY in 2025 where synthetic exists
    panel["vacc_coverage"] = np.where(
        (panel["year"] == 2025) & panel["vacc_coverage_2025"].notna(),
        panel["vacc_coverage_2025"],
        panel["vacc_coverage"]
    )
else:
    log("  ⚠️ No vaccination data available for synthetic 2025; leaving vacc_coverage as-is.")


# google trends
log("Processing Google Trends...")
if GOOGLE_TRENDS_FILE.exists():
    gt = pd.read_csv(GOOGLE_TRENDS_FILE, skiprows=1)
    gt.columns = [c.strip() for c in gt.columns]

    date_col = "Month"
    # adjust if you used a different query name
    val_col_candidates = [c for c in gt.columns if "measles" in c.lower()]
    if not val_col_candidates:
        raise ValueError("Could not find a measles column in Google Trends file.")
    val_col = val_col_candidates[0]

    gt[date_col] = pd.to_datetime(gt[date_col], errors="coerce")

    gt[val_col] = gt[val_col].replace("<1", 0.5)
    gt[val_col] = pd.to_numeric(gt[val_col], errors="coerce")

    gt["month_period"] = gt[date_col].dt.to_period("M")
    gt_monthly = (
        gt.groupby("month_period", as_index=False)[val_col]
        .mean()
        .rename(columns={val_col: "google_trend"})
    )

    # national-level series; same value for all counties per month
    panel = panel.merge(gt_monthly, on="month_period", how="left")
    log(f"  Added Google Trends for {len(gt_monthly)} months.")
else:
    panel["google_trend"] = np.nan
    log("⚠️ Google Trends file not found; google_trend set to NaN.")

# google Trends DMA-level (geoMap.csv)
log("Processing Google Trends geoMap (DMA-level, state-level covariates)...")
if GEOMAP_FILE.exists():
    try:
        # Your file has a first row like "Category: All categories"
        # and the second row has the real headers (DMA, Measles..., MMR..., etc.)
        gmap = pd.read_csv(GEOMAP_FILE, skiprows=1)

        # Identify columns
        dma_col_candidates = [c for c in gmap.columns if "dma" in c.lower()]
        if not dma_col_candidates:
            log("  ⚠️ geoMap.csv has no DMA column; skipping geoMap merge.")
        else:
            dma_col = dma_col_candidates[0]

            # We want four distinct search interest terms:
            measles_term_col = None
            mmr_term_col = None
            measles_virus_col = None
            koplik_col = None

            for c in gmap.columns:
                cl = c.lower()
                if "measles:" in cl and "virus" not in cl and "mmr" not in cl:
                    measles_term_col = c
                elif "mmr vaccine" in cl:
                    mmr_term_col = c
                elif "measles virus" in cl:
                    measles_virus_col = c
                elif "koplik" in cl:
                    koplik_col = c

            if measles_term_col is None and mmr_term_col is None \
               and measles_virus_col is None and koplik_col is None:
                log("  ⚠️ Could not detect measles/MMR-related columns in geoMap.csv; skipping.")
            else:
                # Clean percentages
                interest_cols = [
                    c
                    for c in [measles_term_col, mmr_term_col, measles_virus_col, koplik_col]
                    if c is not None
                ]

                for col in interest_cols:
                    gmap[col] = (
                        gmap[col].astype(str)
                        .str.replace("%", "", regex=False)
                        .str.replace("<1", "0.5", regex=False)
                    )
                    gmap[col] = pd.to_numeric(gmap[col], errors="coerce")

                # Extract state abbreviation from DMA string (e.g., "Lubbock TX" -> "TX")
                gmap["state_abbr"] = gmap[dma_col].astype(str).str.extract(r"([A-Z]{2})$")

                gmap["state_name"] = (
                    gmap["state_abbr"]
                    .map(state_abbr_to_name)
                    .astype(str)
                )

                # Drop rows where we couldn't identify a state
                gmap = gmap[gmap["state_name"].notna()]

                # Aggregate DMA-level values to state-level averages
                agg_dict = {}
                if measles_term_col is not None:
                    agg_dict[measles_term_col] = "mean"
                if mmr_term_col is not None:
                    agg_dict[mmr_term_col] = "mean"
                if measles_virus_col is not None:
                    agg_dict[measles_virus_col] = "mean"
                if koplik_col is not None:
                    agg_dict[koplik_col] = "mean"

                gmap_state = gmap.groupby("state_name", as_index=False).agg(agg_dict)

                # Rename to nicer column names
                rename_map = {}
                if measles_term_col is not None:
                    rename_map[measles_term_col] = "gt_dma_measles"
                if mmr_term_col is not None:
                    rename_map[mmr_term_col] = "gt_dma_mmr_vaccine"
                if measles_virus_col is not None:
                    rename_map[measles_virus_col] = "gt_dma_measles_virus"
                if koplik_col is not None:
                    rename_map[koplik_col] = "gt_dma_koplik_spots"

                gmap_state = gmap_state.rename(columns=rename_map)

                # Merge onto panel by state_name (time-invariant covariates)
                panel = panel.merge(gmap_state, on="state_name", how="left")
                log(f"  Added geoMap-based Google Trends covariates for {len(gmap_state)} states.")
    except Exception as e:
        log(f"  ⚠️ Failed to process geoMap.csv: {e}")
else:
    log(f"  ⚠️ geoMap file {GEOMAP_FILE.name} not found; no DMA-based covariates added.")


# importation/international passengers (COUNTY-level via FIPS)
log("Processing importation data (county-level)...")

if IMPORT_FILE.exists() and USAIRPORTS_FILE.exists():
    # 1) Load importation data
    imp = pd.read_csv(IMPORT_FILE)

    # numeric passenger columns
    for col in [
        "Foreign Originating",
        "Foreign Returning",
        "U.S. Citizen Originating",
        "U.S. Citizen Returning",
    ]:
        imp[col] = pd.to_numeric(imp[col], errors="coerce").fillna(0)

    imp["intl_passengers"] = (
        imp["Foreign Originating"]
        + imp["Foreign Returning"]
        + imp["U.S. Citizen Originating"]
        + imp["U.S. Citizen Returning"]
    )

    # normalize __source_title (airport/city label from your processed I-92)
    imp["title_norm"] = imp["__source_title"].apply(normalize)

    # 2) Load airport → (city, county, state) reference
    air = pd.read_csv(USAIRPORTS_FILE, dtype=str)

    # keep relevant columns
    needed_air_cols = [c for c in ["city", "county", "state"] if c in air.columns]
    air = air[needed_air_cols].dropna()

    air["city_norm"] = air["city"].apply(normalize)

    # one row per (city_norm, state, county)
    air_city = air.drop_duplicates(subset=["city_norm", "state", "county"]).copy()

    # 3) Map import titles to airport city rows
    imp = imp.merge(
        air_city[["city_norm", "state", "county"]],
        left_on="title_norm",
        right_on="city_norm",
        how="left"
    )

    # map state abbrev to full name to match ACS
    imp["state_name_air"] = imp["state"].map(state_abbr_to_name)

    # normalize county from airport file for matching to ACS
    def clean_airport_county(s):
        s = str(s)
        for suf in [" County", " Parish", " Borough", " Census Area", " Municipality"]:
            s = s.replace(suf, "")
        return normalize(s)

    imp["county_norm_air"] = imp["county"].apply(clean_airport_county)

    # 4) Build ACS lookup: (state_name, county_norm) → FIPS
    acs_lookup = acs[["FIPS", "state_name", "county_norm"]].dropna().drop_duplicates()

    # merge to get FIPS for each airport
    imp = imp.merge(
        acs_lookup,
        left_on=["state_name_air", "county_norm_air"],
        right_on=["state_name", "county_norm"],
        how="left",
        suffixes=("", "_acs")
    )

    # how many matched / unmatched?
    n_total = len(imp)
    n_matched = imp["FIPS"].notna().sum()
    log(f"  Importation rows total: {n_total}")
    log(f"  Importation rows matched to a county FIPS: {n_matched}")
    log(f"  Importation rows with no FIPS (will be dropped): {n_total - n_matched}")

    # keep only rows with a valid FIPS
    imp = imp[imp["FIPS"].notna()].copy()
    imp["FIPS"] = imp["FIPS"].astype(str).str.zfill(5)

    # 5) Aggregate to FIPS × year × month
    imp["Year"] = pd.to_numeric(imp["Year"], errors="coerce").astype(int)
    imp["Month Number"] = pd.to_numeric(imp["Month Number"], errors="coerce").astype(int)

    imp_county_month = (
        imp.groupby(["FIPS", "Year", "Month Number"], as_index=False)["intl_passengers"]
        .sum()
        .rename(columns={"Year": "year", "Month Number": "month"})
    )

    log(f"  Aggregated to {len(imp_county_month)} FIPS-year-month rows of intl_passengers.")

    # 6) Merge onto main panel by FIPS + year + month
    panel = panel.merge(
        imp_county_month,
        on=["FIPS", "year", "month"],
        how="left"
    )

    # For county-months with no importation data, set intl_passengers = 0
    panel["intl_passengers"] = panel["intl_passengers"].fillna(0.0)

else:
    panel["intl_passengers"] = 0.0
    if not IMPORT_FILE.exists():
        log(f"  ⚠️ Importation file {IMPORT_FILE.name} not found; intl_passengers set to 0.")
    if not USAIRPORTS_FILE.exists():
        log(f"  ⚠️ usairports.csv not found; intl_passengers set to 0.")

# seasonality
panel = panel.sort_values(["FIPS", "month_period"])
panel["sin_season"] = np.sin(2 * np.pi * panel["month"] / 12.0)
panel["cos_season"] = np.cos(2 * np.pi * panel["month"] / 12.0)

# lags
panel["intl_passengers_lag1"] = panel.groupby("FIPS")["intl_passengers"].shift(1)

# save
log(f"Saving merged county×month panel to {OUTPUT_FILE} ...")
panel.to_csv(OUTPUT_FILE, index=False)
log("Done.")
