import pandas as pd
import numpy as np
import statsmodels.api as sm
from pathlib import Path

# -------------------------------------------------------------------
# 0. Helper logger
# -------------------------------------------------------------------
def log(msg):
    print(f"[INFO] {msg}")

# Path to your merged dataset
BASE_DIR = Path(__file__).resolve().parent
MERGED_FILE = BASE_DIR / "merged_county_month_panel.csv"

# -------------------------------------------------------------------
# 1. Load merged dataset
# -------------------------------------------------------------------
log("Loading merged county-month panel...")
panel = pd.read_csv(MERGED_FILE, dtype={"FIPS": str})
log(f"Panel shape: {panel.shape}")

# Convert month_period if needed
if "month_period" in panel.columns:
    try:
        panel["month_period"] = panel["month_period"].astype("period[M]")
    except:
        panel["month_period"] = pd.to_datetime(panel["month_period"]).dt.to_period("M")

# -------------------------------------------------------------------
# 2. Build discrete hazard structure
# -------------------------------------------------------------------
log("Building discrete-time hazard structure...")

# Ensure event column exists
if "event" not in panel.columns:
    panel["event"] = (panel["cases"] > 0).astype(int)

# First outbreak month per county
first_event = (
    panel[panel["event"] == 1]
    .groupby("FIPS")["month_index"]
    .min()
    .rename("event_time")
)

panel = panel.merge(first_event, on="FIPS", how="left")

# Fail indicator: 1 ONLY at first outbreak
panel["fail"] = (
    (panel["event"] == 1) &
    (panel["month_index"] == panel["event_time"])
).astype(int)

# Risk set = months up to event (or full if no event)
risk_mask = panel["event_time"].isna() | (panel["month_index"] <= panel["event_time"])
panel_hazard = panel[risk_mask].copy()

log(f"Hazard panel shape: {panel_hazard.shape}")
log(f"Failures (first outbreaks): {panel_hazard['fail'].sum()}")

# -------------------------------------------------------------------
# 3. Select covariates
# -------------------------------------------------------------------
exclude_cols = {
    "FIPS", "state_name", "NAME", "GEO_ID",
    "month_period", "date", "cases", "event",
    "fail", "event_time"
}

numeric_cols = [
    c for c in panel_hazard.columns
    if c not in exclude_cols and np.issubdtype(panel_hazard[c].dtype, np.number)
]

log(f"Numeric covariates found: {len(numeric_cols)}")

# Handle missingness: keep <= 40% missing
miss_fraction = panel_hazard[numeric_cols].isna().mean()
good_covs = miss_fraction[miss_fraction <= 0.40].index.tolist()

log(f"Covariates kept after missing filter: {len(good_covs)}")

# -------------------------------------------------------------------
# 4. Impute and drop constant columns
# -------------------------------------------------------------------
df = panel_hazard[good_covs + ["fail"]].copy()
df["fail"] = df["fail"].fillna(0).astype(int)

for c in good_covs:
    df[c] = df[c].fillna(df[c].median())

keep_covs = [c for c in good_covs if df[c].nunique() > 1]
log(f"Covariates kept after dropping constants: {len(keep_covs)}")

# Final matrices
X = df[keep_covs]
y = df["fail"]

log(f"Final modeling matrix: X={X.shape}, y={len(y)}")

X = sm.add_constant(X)

# -------------------------------------------------------------------
# 5. Fit the hazard model using complementary log-log link
# -------------------------------------------------------------------
log("Fitting discrete-time cloglog hazard model...")

model = sm.GLM(
    y,
    X,
    family=sm.families.Binomial(link=sm.families.links.cloglog())
)

results = model.fit()
print(results.summary())

# -------------------------------------------------------------------
# 6. Rank covariates
# -------------------------------------------------------------------
coef_table = pd.DataFrame({
    "variable": results.params.index,
    "coef": results.params.values,
    "pvalue": results.pvalues.values
})

coef_table = coef_table[coef_table["variable"] != "const"]
coef_table["abs_coef"] = coef_table["coef"].abs()

ranked = coef_table.sort_values("abs_coef", ascending=False)
significant = ranked[ranked["pvalue"] < 0.05]

ranked.to_csv(BASE_DIR / "hazard_model_ranked.csv", index=False)
significant.to_csv(BASE_DIR / "hazard_model_significant.csv", index=False)

log("Saved:")
log("  hazard_model_ranked.csv")
log("  hazard_model_significant.csv")

